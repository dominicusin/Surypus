packages:
  ./
  ./surypus-common/surypus-common.cabal
  ./surypus-api/surypus-api.cabal

-- Package constraints (Cabal only; stack.yaml does not support this field)
constraints:
  base >= 4.16 && < 4.22,
  text >= 2.0,
  aeson >= 2.1,
  time >= 1.11,
  containers >= 0.6,
  servant >= 0.20,
  servant-server >= 0.20,
  wai >= 3.2,
  warp >= 3.3,
  hasql >= 1.6,
  hasql-pool >= 0.10,
  postgresql-binary >= 0.12,
  crypton -any,
  cryptonite ==0.30,
  jose >=0.10 && <0.11
