packages:
  surypus-common/surypus-common.cabal
  surypus-api/surypus-api.cabal
  surypus-frontend/surypus-frontend.cabal



-- Compiler configuration
with-compiler: ghc-9.4.8

-- Global constraints for compatibility
constraints:
  base >= 4.16 && < 4.22,
  text >= 2.0,
  aeson >= 2.1,
  time >= 1.11,
  containers >= 0.6

-- Servant constraints
constraints:
  servant >= 0.20,
  servant-server >= 0.20,
  servant-client >= 0.20,
  wai >= 3.2,
  warp >= 3.3

-- Database constraints
constraints:
  hasql >= 1.6,
  hasql-pool >= 0.10,
  postgresql-binary >= 0.12

-- Package-specific constraints
package surypus-api
  optimization: 2
  ghc-options: -Wall -Wcompat -threaded -rtsopts

package surypus-frontend
  optimization: 2
  ghc-options: -Wall -Wcompat
  constraints:
    reflex >= 0.6,
    reflex-dom >= 0.6

-- Test dependencies
constraints:
  hspec >= 2.11,
  QuickCheck >= 2.14

-- Nix support (disabled)
nix:
  enable: false

-- Documentation
package-documentation: true