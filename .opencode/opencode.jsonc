{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {}
    }
  },
  "permission": {
    "edit": {
      "**": "allow"
    },
    "read": {
      "**": "allow"
    }
  },
  "tools": {
    "github-triage": true,
    "github-pr-search": true,
    "websearch": true,
    "webfetch": true,
    "codesearch": true
  }
}