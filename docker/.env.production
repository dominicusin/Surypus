# docker/.env.production - Production environment variables
# IMPORTANT: Change all default passwords and secrets before deployment!

# Application
APP_PORT=8080
APP_ENV=production
LOG_LEVEL=WARN

# Database (update these for your production database)
DATABASE_URL=postgresql://surypus:CHANGE_ME@postgres:5432/surypus
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30

# JWT - MUST change in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
JWT_EXPIRATION_HOURS=24
SESSION_SECRET=CHANGE_ME_ANOTHER_RANDOM_STRING_MIN_32_CHARS

# OPA
OPA_URL=http://opa:8181

# Kafka
KAFKA_BROKERS=redpanda:9092

# Redis (for sessions, caching)
REDIS_URL=redis://redis:6379

# Feature flags
FEATURE_ASYNC_JOBS=true
FEATURE_WEBSOCKETS=true
FEATURE_AUDIT_LOG=true