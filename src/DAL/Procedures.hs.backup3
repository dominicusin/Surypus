createSalaryRecord :: Pool -> Int64 -> Int64 -> Day -> Day -> Double -> IO (QueryResult Int64)
createSalaryRecord pool employeeId chargeId periodStart periodEnd amount = do
  let stmt =
        preparable
          "SELECT create_salary_record($1, $2, $3, $4, $5, 0, 0, 0)"
