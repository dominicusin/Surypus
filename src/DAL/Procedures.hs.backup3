-- | List goods with pagination using stored procedure
data GoodsListResult = GoodsListResult
  { glrItems :: [Goods],
    glrTotal :: Int64
  }

goodsListResultDecoder :: D.Row GoodsListResult
goodsListResultDecoder =
  GoodsListResult
    <$> (D.rowList goodsSpDecoder)
    <*> D.column (D.nonNullable D.int8)

spGoodsList :: Pool -> Maybe Text -> Maybe Text -> Maybe Text -> Maybe Text -> Bool -> Int -> Int -> IO (QueryResult GoodsListResult)
spGoodsList pool mNameFilter mBarcodeFilter mCodeFilter mSortBy sortDesc limit offset = do
  let stmt =
        preparable
          "SELECT id, code, name, barcode, unit_id, parent_id FROM sp_goods_list($1, $2, $3, $4, $5, $6, $7, $8)"
          ( ((\(a, _, _, _, _, _, _, _) -> a) >$< E.param (E.nullable E.text))
              <> ((\(_, b, _, _, _, _, _, _) -> b) >$< E.param (E.nullable E.text))
              <> ((\(_, _, c, _, _, _, _, _) -> c) >$< E.param (E.nullable E.text))
              <> ((\(_, _, _, d, _, _, _, _) -> d) >$< E.param (E.nullable E.text))
              <> ((\(_, _, _, _, e, _, _, _) -> e) >$< E.param (E.nonNullable E.bool))
              <> ((\(_, _, _, _, _, f, _, _) -> f) >$< E.param (E.nonNullable E.int4))
              <> ((\(_, _, _, _, _, _, g, _) -> g) >$< E.param (E.nonNullable E.int4))
              <> ((\(_, _, _, _, _, _, _, h) -> h) >$< E.param (E.nonNullable E.int4))
          )
          (D.rowMaybe goodsListResultDecoder)
  res <- use pool $ Session.statement (mNameFilter, mBarcodeFilter, mCodeFilter, mSortBy, sortDesc, limit, offset) stmt
  case res of
    Right (Just r) -> pure $ QuerySuccess r
    Right Nothing -> pure $ QuerySuccess (GoodsListResult [] 0)
    Left err -> pure $ QueryError (T.pack $ show err)

