-- ============================================================================
-- BILL PROCEDURES
-- ============================================================================

data BillTotals = BillTotals
  { btTotal :: Decimal,
    btDiscount :: Decimal,
    btVatAmount :: Decimal,
    btTotalWithVat :: Decimal
  }

billTotalsDecoder :: D.Row BillTotals
billTotalsDecoder =
  BillTotals
    <$> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))

calcBillTotals :: Pool -> Int64 -> IO (QueryResult BillTotals)
calcBillTotals pool billId = do
  let stmt =
        preparable
          "SELECT total, discount, vat_amount, total_with_vat FROM calc_bill_totals($1)"
          (E.param (E.nonNullable E.int8))
          (D.rowMaybe billTotalsDecoder)
  res <- use pool $ Session.statement billId stmt
  case res of
    Right (Just t) -> pure $ QuerySuccess t
    Right Nothing -> pure $ QueryError "Bill not found"
    Left err -> pure $ QueryError (T.pack $ show err)

data LineTotals = LineTotals
  { ltAmount :: Decimal,
    ltDiscount :: Decimal,
    ltVatAmount :: Decimal,
    ltTotal :: Decimal
  }

lineTotalsDecoder :: D.Row LineTotals
lineTotalsDecoder =
  LineTotals
    <$> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))

calcLineTotals :: Pool -> Double -> Double -> Double -> Double -> IO (QueryResult LineTotals)
calcLineTotals pool qty price discount vatRate = do
  let stmt =
        preparable
          "SELECT amount, discount, vat_amount, total FROM calc_line_totals($1, $2, $3, $4)"
          ( ((\(a, _, _, _) -> a) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, b, _, _) -> b) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, c, _) -> c) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, _, d) -> d) >$< E.param (E.nonNullable E.float8))
          )
          (D.rowMaybe lineTotalsDecoder)
  res <- use pool $ Session.statement (qty, price, discount, vatRate) stmt
  case res of
    Right (Just t) -> pure $ QuerySuccess t
    Right Nothing -> pure $ QueryError "Calculation failed"
    Left err -> pure $ QueryError (T.pack $ show err)

recalcBillTotals :: Pool -> Int64 -> IO (QueryResult Bool)
recalcBillTotals pool billId = do
  let stmt =
        preparable
          "SELECT recalc_bill_totals($1)"
          (E.param (E.nonNullable E.int8))
          (D.singleRow (D.column D.bool))
  res <- use pool $ Session.statement billId stmt
  case res of
    Right v -> pure $ QuerySuccess v
    Left err -> pure $ QueryError (T.pack $ show err)

