batchPostBills :: Pool -> [Int64] -> IO (QueryResult Int)
batchPostBills pool billIds = do
  let stmt =
        preparable
          "SELECT batch_post_bills($1)"
          (E.param (E.nonNullable (E.array E.int8)))
          (D.singleRow (fromIntegral <$> D.column D.int4))
  res <- use pool $ Session.statement billIds stmt
  case res of
    Right v -> pure $ QuerySuccess v
    Left err -> pure $ QueryError (T.pack $ show err)

-- ============================================================================
-- BILL LINE PROCEDURES
-- ============================================================================

createBillLine :: Pool -> Int64 -> Int64 -> Double -> Double -> Double -> Double -> Double -> Double -> IO (QueryResult Int64)
createBillLine pool billId goodsId qty price discount vatRate vatAmount lineTotal = do
  let stmt =
        preparable
          "SELECT create_bill_line($1, $2, $3, $4, $5, $6, $7, $8)"
          ( ((\(a, _, _, _, _, _, _, _) -> a) >$< E.param (E.nonNullable E.int8))
              <> ((\(_, b, _, _, _, _, _, _) -> b) >$< E.param (E.nonNullable E.int8))
              <> ((\(_, _, c, _, _, _, _, _) -> c) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, _, d, _, _, _, _) -> d) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, _, _, e, _, _, _) -> e) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, _, _, _, f, _, _) -> f) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, _, _, _, _, g, _) -> g) >$< E.param (E.nonNullable E.float8))
              <> ((\(_, _, _, _, _, _, _, h) -> h) >$< E.param (E.nonNullable E.float8))
          )
          (D.singleRow (D.column D.int8))
  res <- use pool $ Session.statement (billId, goodsId, qty, price, discount, vatRate, vatAmount, lineTotal) stmt
  case res of
    Right v -> pure $ QuerySuccess v
    Left err -> pure $ QueryError (T.pack $ show err)

