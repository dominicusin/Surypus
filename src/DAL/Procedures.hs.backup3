        preparable
          "SELECT calc_salary_sum($1, $2, $3, $4)"
          ( ((\(a, _, _, _) -> a) >$< E.param (E.nonNullable E.int8))
              <> ((\(_, b, _, _) -> b) >$< E.param (E.nonNullable E.int8))
              <> ((\(_, _, c, _) -> c) >$< E.param (E.nonNullable E.date))
              <> ((\(_, _, _, d) -> d) >$< E.param (E.nonNullable E.date))
          )
