data StockBalance = StockBalance
  { sbGoodsId :: Int64,
    sbLocationId :: Int64,
    sbQuantity :: Decimal
  }

stockBalanceDecoder :: D.Row StockBalance
stockBalanceDecoder =
  StockBalance
    <$> D.column (D.nonNullable D.int8)
    <*> D.column (D.nonNullable D.int8)
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))

calcStockBalance :: Pool -> Int64 -> Int64 -> Maybe Double -> IO (QueryResult Decimal)
calcStockBalance pool goodsId locationId mInitialQty = do
  let stmt =
        preparable
          "SELECT calc_stock_balance($1, $2, $3)"
          ( (fst >$< E.param (E.nonNullable E.int8))
              <> ((snd . fst) >$< E.param (E.nonNullable E.int8))
              <> (snd >$< E.param (E.nullable E.float8))
          )
          (D.singleRow (Decimal . round <$> D.column (D.nonNullable D.numeric)))
  res <- use pool $ Session.statement (goodsId, locationId, fmap fromDouble mInitialQty) stmt
  case res of
    Right v -> pure $ QuerySuccess v
    Left err -> pure $ QueryError (T.pack $ show err)

calcGoodsAvgCost :: Pool -> Int64 -> Int64 -> IO (QueryResult Decimal)
calcGoodsAvgCost pool goodsId locationId = do
  let stmt =
        preparable
          "SELECT calc_goods_avg_cost($1, $2)"
          ( (fst >$< E.param (E.nonNullable E.int8))
              <> (snd >$< E.param (E.nonNullable E.int8))
          )
          (D.singleRow (Decimal . round <$> D.column (D.nonNullable D.numeric)))
  res <- use pool $ Session.statement (goodsId, locationId) stmt
  case res of
    Right v -> pure $ QuerySuccess v
    Left err -> pure $ QueryError (T.pack $ show err)

