    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))

fifoSelectLots :: Pool -> Int64 -> Int64 -> Double -> IO (QueryResult [FifoLot])
fifoSelectLots pool goodsId locationId qtyNeeded = do
  let stmt =
