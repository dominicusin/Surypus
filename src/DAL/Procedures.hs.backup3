data GoodsByBarcode = GoodsByBarcode
  { gbbGoodsId :: Int64,
    gbbGoodsCode :: Maybe Text,
    gbbGoodsName :: Text,
    gbbGoodsPrice :: Decimal,
    gbbGoodsCost :: Decimal
  }

goodsByBarcodeDecoder :: D.Row GoodsByBarcode
goodsByBarcodeDecoder =
  GoodsByBarcode
    <$> D.column (D.nonNullable D.int8)
    <*> D.column (D.nullable D.text)
    <*> D.column (D.nonNullable D.text)
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))

getGoodsByBarcode :: Pool -> Text -> IO (QueryResult GoodsByBarcode)
getGoodsByBarcode pool barcode = do
  let stmt =
        preparable
          "SELECT goods_id, goods_code, goods_name, goods_price, goods_cost FROM get_goods_by_barcode($1)"
          (E.param (E.nonNullable E.text))
          (D.rowMaybe goodsByBarcodeDecoder)
  res <- use pool $ Session.statement barcode stmt
  case res of
    Right (Just g) -> pure $ QuerySuccess g
    Right Nothing -> pure $ QueryError "Goods not found"
    Left err -> pure $ QueryError (T.pack $ show err)

