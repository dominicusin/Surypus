data TrialBalanceEntry = TrialBalanceEntry
  { tbeAccountCode :: Text,
    tbeAccountName :: Text,
    tbeDebit :: Decimal,
    tbeCredit :: Decimal
  }

trialBalanceDecoder :: D.Row TrialBalanceEntry
trialBalanceDecoder =
  TrialBalanceEntry
    <$> D.column (D.nonNullable D.text)
    <*> D.column (D.nonNullable D.text)
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))
    <*> (Decimal . round <$> D.column (D.nonNullable D.numeric))

getTrialBalance :: Pool -> Day -> Day -> IO (QueryResult [TrialBalanceEntry])
getTrialBalance pool dateFrom dateTo = do
  let stmt =
        preparable
          "SELECT account_code, account_name, debit, credit FROM get_trial_balance($1, $2)"
          ( (fst >$< E.param (E.nonNullable E.date))
              <> (snd >$< E.param (E.nonNullable E.date))
          )
          (D.rowList trialBalanceDecoder)
  res <- use pool $ Session.statement (dateFrom, dateTo) stmt
  case res of
    Right entries -> pure $ QuerySuccess entries
    Left err -> pure $ QueryError (T.pack $ show err)

