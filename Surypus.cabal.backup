cabal-version: 3.4
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        GPL-3.0-or-later
build-type:     Simple

library
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
          Surypus
          Surypus.Types
          Finance
          Finance.Account
          Finance.Ledger
          Finance.Tax
          Finance.Journal
          Finance.Accounting
          Finance.AccSheet2
          Finance.AccTurn2
          Finance.AccturnDiffs
          Finance.SheetDiffs
          Commerce
          Commerce.Invoice
          Commerce.Price
          Commerce.PriceByAgent
          Commerce.PriceByQtty
          Commerce.PriceByTime
          Commerce.PriceRule
          Commerce.Discount
          Commerce.Contract
          Commerce.Orders.Order
          Commerce.Orders.Preorder
          Commerce.Orders.Quotation
          Commerce.Orders.Quote
          Commerce.Payments.Payment
          Commerce.Payments.PaymentCard
          HR
          HR.Contact
          HR.Person
          HR.Relation
          HR.Operations
          HR.Employee
          HR.Position
          HR.Types
          HR.PersonEx
          HR.Salary
          Inventory
          Inventory.Goods
          Inventory.Location
          Inventory.Lot
          Production
          Production.TechCard
          Production.MRP
          Production.Types
          Production.WorkOrder
          Production.Activity
          Production.Project
          Production.Task
          Production.Service
          Production.ServiceManager
          Tech
          Tech.TechCard
          Tech.TechIssue
          System
          System.Settings
          System.Config
          System.Log
          System.Validator
          System.Version
          System.Sequence
          System.Counter
          System.Event
          System.AccessControl
          System.Audit
          System.Alert
          System.Auth
          System.Session
          Infrastructure
          Infrastructure.Backup
          Infrastructure.Migration
          External
          External.EGAIS
          Integration
          Integration.ImportExport
          Integration.Sync
          Reports
          Reports.Report
          Reports.Jasper
          Reports.Service
          Analytics
          Analytics.Analytics
          Analytics.Chart
          Analytics.Prediction
          Messaging
          Messaging.Message
          Messaging.Communication
          Logistics
          Logistics.Warehouse
          Logistics.Transport
          Logistics.Receipt
          Logistics.Transfer
          Retail
          Retail.Terminal
          Retail.CashRegister
          Retail.CashSessionTemp
          API
          DAL
          Core

  build-depends:
      base >=4.12 && <5
    , text >=1.2
    , time >=1.8
    , uuid >=1.3
    , aeson >=2.2
    , containers >=0.6
    , vector >=0.12
    , hasql >=1.6
    , hasql-pool >=1.3
    , transformers >=0.5
    , mtl >=2.3
    , QuickCheck >=2.14
    , Decimal >=0.5
    , servant-server >=0.20
    , wai >=3.2
    , scotty >=0.21