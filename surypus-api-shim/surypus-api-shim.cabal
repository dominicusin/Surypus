cabal-version: 3.0
name: surypus-api-shim
version: 0.1.0.0
synopsis: Shim wrapper for Surypus API
license: Apache-2.0
category: Web
build-type: Simple

library
  exposed-modules: Surypus.APIShim.Server
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
    base >=4.12 && <5,
    Surypus,
    hasql-pool >=1.4,
    wai >=3.2,
    text >=1.2
