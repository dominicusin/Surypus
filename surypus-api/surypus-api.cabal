cabal-version: 3.0
name:                surypus-api
version:             0.1.0.0
synopsis:            REST API Backend for Surypus ERP
description:         High-performance Servant backend implementing the core business logic
license:             AGPL-3.0-only
author:              dominicusin
maintainer:          dev@surypus.com
copyright:           2024 Surypus
category:            Web

library
  exposed-modules:
    Surypus.API.Server
    Surypus.API.Dashboard
    Surypus.API.CRM
    Surypus.API.Bills
    Surypus.API.Payment
    Surypus.API.Persons
    Surypus.API.Goods
    Surypus.API.Auth
    Surypus.API.Logger
  build-depends:
    base              >= 4.16 && < 4.18,
    Surypus            == 0.1.0.0,
    text               >= 2.0,
    surypus-common    == 0.1.0.0,
    servant          >= 0.20,
    servant-server    >= 0.20,
    wai               >= 3.2,
    warp              >= 3.3,
    http-types,
    aeson,
    postgresql-binary,
    time,
    containers,
    mtl,
    bytestring,
    transformers      >= 0.5,
    websockets,
    wai-websockets,
    uuid              >= 1.3,
    fast-logger       >= 3.2,
    hasql,
    hasql-pool
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:
    -Wall
    -Wcompat

executable surypus-api
  main-is:             Main.hs
  build-depends:
    base,
    surypus-api,
    warp
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -O2
  default-extensions:
    OverloadedStrings
    DuplicateRecordFields
    DeriveGeneric
