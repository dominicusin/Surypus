cabal-version: 3.0
name:          surypus-api
version:       0.1.0.0
synopsis:      REST API Backend for Surypus ERP
license:       AGPL-3.0-only
author:        dominicusin
maintainer:    dev@surypus.com
category:      Web

library
  exposed-modules:
    Infrastructure.Email
    Surypus.API.AI
    Surypus.API.Bills
    Surypus.API.Classifiers
    Surypus.API.CRM
    Surypus.API.Dashboard
    Surypus.API.Goods
    Surypus.API.Integrations
    Surypus.API.Logger
    Surypus.API.Notifications
    Surypus.API.Orders
    Surypus.API.Payment
    Surypus.API.Persons
    Surypus.API.Reports
    Surypus.API.Server
    Surypus.API.Workflow
    Surypus.JWT.Token

  other-modules:
    DAL.Classifiers
    DAL.Database
    DAL.Mutations
    DAL.Queries
    DAL.Repository

  build-depends:
    , aeson
    , base               >=4.16    && <4.18
    , bytestring
    , containers
    , contravariant
    , cryptonite         >=0.30
    , fast-logger        >=3.2
    , hasql
    , hasql-pool
    , http-client
    , http-conduit
    , http-types
    , jose               >=0.10    && <0.11
    , lens
    , mime-mail
    , mtl
    , network-uri
    , persistent         >=2.14
    , persistent-postgresql >=2.14
    , persistent-template >=2.14
    , esqueleto           >=3.5
    , postgresql-binary
    , postgresql-simple  >=0.6     && <0.8
    , resource-pool      >=0.2     && <0.3
    , servant            >=0.20
    , servant-server     >=0.20
    , smtp-mail
    , Surypus            ==0.1.0.0
    , surypus-common     ==0.1.0.0
    , text               >=2.0
    , time
    , transformers       >=0.5
    , uuid               >=1.3
    , wai                >=3.2
    , wai-websockets
    , warp               >=3.3
    , websockets

  hs-source-dirs:   src src/Surypus
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat

test-suite surypus-api-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:
    Surypus.AITest
    Surypus.API.IntegrationsSpec
    Surypus.JWT.TokenSpec

  build-depends:
    , aeson
    , base
    , bytestring
    , hspec
    , hspec-core
    , jose
    , lens
    , surypus-api
    , text
    , time

  hs-source-dirs:   test
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat

executable surypus-api
  main-is:            Main.hs
  build-depends:
    , base
    , hasql
    , hasql-pool
    , Surypus
    , surypus-api
    , time
    , warp

  hs-source-dirs:     app
  default-language:   Haskell2010
  ghc-options:        -Wall -Wcompat -threaded -rtsopts -with-rtsopts=-N -O2
  default-extensions:
    DeriveGeneric
    DuplicateRecordFields
    OverloadedStrings
