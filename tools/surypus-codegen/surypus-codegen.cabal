cabal-version: 3.4
name:           surypus-codegen
version:        0.1.0.0
synopsis:       Transpiler for Surypus ERP
description:    Generates the full stack from dsl/schema.yaml
category:       Development
author:         Unknown
license:        MPL-2.0
build-type:     Simple

executable surypus-codegen
  default-language: Haskell2010
  hs-source-dirs: .
  main-is: Main.hs
  build-depends:
    base >=4.12 && <5,
    aeson >=2.0 && <2.3,
    yaml >=0.11 && <0.12,
    bytestring,
    text,
    time,
    directory,
    filepath,
    containers
  default-extensions: OverloadedStrings