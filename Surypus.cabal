    hs-source-dirs: src

    build-depends:
          base >=4.12 && <5
        , text >=1.2
        , time >=1.8
        , bytestring >=0.10
        , aeson >=2.2
        , uuid >=1.3
        , containers >=0.6
        , vector >=0.12
        , hspec >=2.10
        , QuickCheck >=2.14
        , cryptonite >=0.30
        , memory >=0.18
        , directory >=1.3
        , transformers >=0.5
        , mtl >=2.3
        , stm >=2.5
        , hasql >=1.10
        , hasql-pool >=1.4
        , scientific >=0.3
        , jose >=0.10
        , lens >=5.3
        , wai-websockets >=3.0
        , websockets >=0.12
        , warp >=3.3
        , wai >=3.2
        , http-types >=0.12
        , servant >=0.20
        , servant-server >=0.20
        , servant-client >=0.20
        , servant-auth-server >=0.4
        , servant-swagger >= 0.3
        , swagger2 >= 2.6
        , persistent >=2.14
        , persistent-template >=2.12

    default-language: Haskell2010
  ghc-options: -Wall -Werror

executable surypus
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
        base >=4.12 && <5
      , Surypus
      , text >=1.2
      , aeson >=2.2
      , warp >=3.3
      , http-types >=0.12
      , wai >=3.2
      , wai-websockets >=3.0
      , websockets >=0.12
      , bytestring >=0.10
      , containers >=0.6
      , directory >=1.3
      , hasql-pool >=1.4
      , transformers >=0.5
      , time >=1.8
      , servant >=0.20
      , servant-server >=0.20
      , servant-auth-server >=0.4
      , jose >=0.10
      , lens >=5.3
      , mtl >=2.3
      , persistent >=2.14
      , persistent-postgresql >=2.14
  default-language: Haskell2010
  ghc-options: -threaded

test-suite test
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test
  other-modules:
      API.ServerSpec
      DB.RepositoriesSpec
      Domain.BillSpec
      Domain.GoodsSpec
      Domain.LocationSpec
      Domain.PayrollSpec
      Domain.PersonSpec
      Domain.TypesSpec
      Integration.CrudSpec
      Integration.NegativeSpec
      Integration.PropertySpec
      TestFixtures
      RBACSpec
  build-depends:
         base >=4.12 && <5
       , Surypus
      , text >=1.2
      , time >=1.8
      , hspec >=2.10
      , QuickCheck >=2.14
      , uuid >=1.3
      , bytestring >=0.10
      , aeson >=2.2
      , containers >=0.6
      , vector >=0.12
      , hasql >=1.10
      , hasql-pool >=1.4
      , transformers >=0.5
      , mtl >=2.3
       , wai >=3.2
       , wai-extra >=3.1
       , warp >=3.3
      , http-types >=0.12
      , scotty >=0.20
      , lens >=5.3
  default-language: Haskell2010
  ghc-options: -Wwarn
