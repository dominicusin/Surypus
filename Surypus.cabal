cabal-version: 1.12
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        GPL-3
build-type:     Simple
library
    exposed-modules:
        Core
        Core.Asset
        Core.Goods
        Core.Document
        Core.Document.Types
        Core.Person
        Core.Person.Contact
        Core.Person.Person
        Core.Person.Relation
        Core.Person.Operations
        Core.Warehouse
        Core.Auth
        Core.Auth.Operations
        Core.Commerce
        Core.HR
        Core.HR.Employee
        Core.HR.Position
        Core.HR.Types
        Core.Unit
        Core.Inventory
        Core.Inventory.Types
        Core.Inventory.Types.Location
        Core.Inventory.Types.Stock
        Core.Inventory.Types.Lot
        Core.Inventory.Types.Inventory
        Core.Inventory.Operations
        Core.Accounting
        Core.Accounting.Account
        Core.Accounting.Ledger
        Core.Accounting.Types
        Core.Accounting.Operations
        Core.Payroll
        Core.Payroll.Types
        Core.Payroll.Calculation
        Core.Payroll.Operations
        Core.Tax
        Core.Currency
        Core.Currency.Operations
        Core.Invoice
        Core.Invoice.Operations
        Core.Price
        Core.Price.Operations
        Core.Refined
        DAL.Types
        Surypus.Types
        Surypus.Error
        Surypus.Logging
        Surypus.Validation
        Surypus.Refined
        Surypus.Refined.Predicates
        Surypus.Z3
        Surypus.I18n

    hs-source-dirs: src

    build-depends:
          base >=4.12 && <5
        , text >=1.2
        , time >=1.8
        , bytestring >=0.10
        , aeson >=2.0
        , uuid >=1.3
        , containers >=0.6
        , vector >=0.12
        , hspec >=2.10
        , QuickCheck >=2.14
        , cryptonite >=0.30
        , memory >=0.18
        , transformers >=0.5
        , hasql >=1.10
        , hasql-pool >=1.4

    default-language: Haskell2010
    ghc-options: -Wall -Werror

executable surypus
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
        base >=4.12 && <5
      , Surypus
      , text >=1.2
      , aeson >=2.0
      , warp >=3.3
      , http-types >=0.12
      , wai >=3.2
      , bytestring >=0.10
      , containers >=0.6
      , transformers >=0.5
      , time >=1.8
  default-language: Haskell2010
  ghc-options: -threaded

test-suite test
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test, src
  build-depends:
        base >=4.12 && <5
      , Surypus
      , text >=1.2
      , time >=1.8
      , hspec >=2.10
      , QuickCheck >=2.14
      , uuid >=1.3
      , bytestring >=0.10
      , aeson >=2.0
      , containers >=0.6
      , vector >=0.12
      , hasql >=1.10
      , hasql-pool >=1.4
  default-language: Haskell2010
