executable surypus-server
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , wai
    , wai-extra
    , warp
    , aeson
    , text
    , bytestring
    , http-types
    , time
    , directory
    , filepath
    , Decimal
    , network
  default-extensions: OverloadedStrings

test-suite surypus-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  other-modules:
      Finance.TaxSpec
      Finance.AccountingSpec
  build-depends:
      base >=4.12 && <5
      , Surypus
      , hspec
      , QuickCheck
      , text
      , time
      , aeson
      , bytestring
      , stm
      , containers
      , Decimal
  default-language: Haskell2010
