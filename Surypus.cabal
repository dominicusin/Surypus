cabal-version: 3.4
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        GPL-3.0-or-later
build-type:     Simple

library
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
    Core.Payroll.Calculation
    DAL.Database
    DAL.Pool
    DAL.Schema
    DAL.Types
    Finance.Accounting
    Finance.Tax
    Surypus
    Surypus.CoreTypes
    Surypus.JWT
    Surypus.Metrics
    Surypus.RBAC
    Surypus.RefreshTokenRepo

  build-depends:
    base >=4.12 && <5
    , aeson
    , bytestring
    , text
    , time
    , Decimal
    , persistent
    , persistent-postgresql
    , persistent-template
    , esqueleto
    , monad-logger
    , wai
    , wai-extra
    , warp
    , http-types
    , directory
    , filepath
    , network
    , containers
    , transformers
    , mtl
    , stm
    , uuid
    , lens
    , katip
    , jose
    , cryptonite
    , yaml
    , servant
    , servant-server
    , resource-pool
    , QuickCheck
    , hspec

executable surypus-server
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , wai
    , wai-extra
    , warp
    , aeson
    , text
    , bytestring
    , http-types
    , time
    , directory
    , filepath
    , Decimal
    , network
  default-extensions: OverloadedStrings


executable ai-report
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: ai-report.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , text
    , aeson
    , time
  default-extensions: OverloadedStrings
test-suite surypus-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  other-modules:
      Finance.TaxSpec
      Finance.AccountingSpec
  build-depends:
      base >=4.12 && <5
      , Surypus
      , hspec
      , QuickCheck
      , text
      , time
      , aeson
      , bytestring
      , stm
      , containers
      , Decimal
  default-language: Haskell2010
