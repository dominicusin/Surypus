-- ============================================================================
-- EXECUTABLE
-- ============================================================================
executable surypus
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.12 && <5
    , Surypus
    , text >=1.2
    , aeson >=2.0
    , warp >=3.3
    , http-types >=0.12
    , wai >=3.2
    , bytestring >=0.10
    , containers >=0.6
    , transformers >=0.5
    , time >=1.8
    , hasql-pool >=0.7
  default-language: Haskell2010
  ghc-options: -threaded
executable surypus-job-worker
  main-is: JobWorker.hs
  hs-source-dirs: app
  build-depends:
      base >=4.12 && <5
    , Surypus
    , hasql >=1.4.5.3
    , hasql-pool >=0.7
    , bytestring >=0.10
    , text >=1.2
    , time >=1.8
    , containers >=0.6
    , transformers >=0.5
    , vector >=0.12
  default-language: Haskell2010
test-suite test
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test, src
  other-modules:
      Core.Accounting.Account
      Core.Tax
      Core.Payroll.Calculation
      Core.Payroll.Types
      Core.Refined
      Surypus.Types
      Surypus.Reports.Conversion.CrystalTypes
  build-depends:
      base >=4.12 && <5
    , Surypus
    , text >=1.2
    , time >=1.8
    , hspec >=2.10
    , QuickCheck >=2.14
    , uuid >=1.3
    , bytestring >=0.10
    , aeson >=2.0
    , containers >=0.6
    , vector >=0.12
  default-language: Haskell2010

-- Integration test: pool wiring sanity check
test-suite test-integration-pool
  type: exitcode-stdio-1.0
  main-is: PoolSpec.hs
  hs-source-dirs: test/Integration
  build-depends:
      base >=4.12 && <5
    , Surypus
    , hasql >=1.6.0.0
    , hasql-pool >=0.7
    , text >=1.2
    , time >=1.8
    , hspec >=2.10
  default-language: Haskell2010

-- Integration test: API CRUD over real DB
test-suite test-integration-api
  type: exitcode-stdio-1.0
  main-is: APICrudSpec.hs
  hs-source-dirs: test/Integration
  build-depends:
      base >=4.12 && <5
    , Surypus
    , aeson >=2.0
    , bytestring >=0.10
    , hasql >=1.6.0.0
    , hasql-pool >=0.7
    , text >=1.2
    , time >=1.8
    , hspec >=2.10
    , http-conduit >=2.3
    , http-types >=0.12
  default-language: Haskell2010
  ghc-options: -threaded
