cabal-version: 1.12
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        GPL-3
build-type:     Simple
library
    exposed-modules:
        Core
        Core.Asset
        Core.Goods
        Core.Document
        Core.Document.Types
        Core.Person
        Core.Person.Operations
        Core.Warehouse
        Core.Auth
        Core.Auth.Operations
        Core.Commerce
        Core.HR
        Core.HR.Types
        Core.Unit
        Core.Inventory
        Core.Inventory.Types
        Core.Inventory.Types.Location
        Core.Inventory.Types.Stock
        Core.Inventory.Types.Lot
        Core.Inventory.Types.Inventory
        Core.Inventory.Operations
        Core.Accounting
        Core.Accounting.Account
        Core.Accounting.Ledger
        Core.Accounting.Types
        Core.Accounting.Operations
        Core.Payroll
        Core.Payroll.Types
        Core.Payroll.Calculation
        Core.Payroll.Operations
        Core.Tax
        Core.Currency
        Core.Currency.Operations
        Core.Invoice
        Core.Invoice.Operations
        Core.Price
        Core.Price.Operations
        DAL
        DAL.Types
        DAL.Queries
        DAL.Mutations
        APIServer
        DB.Connection
        Surypus.Types
        Surypus.Error
        Surypus.Logging
        Surypus.Validation
        Surypus.JWT
        Surypus.RBAC
        Surypus.Refined
        Surypus.Refined.Predicates
        Surypus.Z3
        Surypus.Core
        Surypus.I18n
        Surypus.WebSocket
    other-modules:
      DB
      Surypus
      Surypus.Reports
      Surypus.JobRunner
      Core.HR.Employee
      Core.HR.Position
      Core.Person.Contact
      Core.Person.Person
      Core.Person.Relation
      Core.Refined
      Domain.Goods
      Domain.Bill
      Domain.Stock
      Domain.Location
      Domain.Accounting
      Domain.Document
      Domain.Document.Audit
      Domain.Payroll
      Domain.Person
      Domain.Core
      Domain.Inventory
      Domain.Asset
      Domain.HR
      Domain.Production
      Domain.TechCard
      Domain.Job
      Domain.ReportJob
      Domain.ReportSchedule
      Domain.Types
      DAL.Repository
      DAL.Repository.Person
      DAL.Repository.Goods
      DAL.Repository.Location
      DAL.Repository.Payment
      DAL.Repository.Price
      DAL.Repository.Tax
      DAL.Repository.Currency
      DAL.Repository.Bill
      DAL.Repository.Order
      DAL.Repository.Container
    hs-source-dirs:
      src
    build-depends:
      base >=4.12 && <5
      , text >=1.2
      , time >=1.8
      , bytestring >=0.10
      , aeson >=2.0
      , base64-bytestring >=0.1
      , scotty >=0.14
      , warp >=3.3
      , wai >=3.2
      , wai-logger >=2.3
      , http-types >=0.12
      , hasql >=1.6.0.0
      , hasql-pool >=0.7
      , uuid >=1.3
      , containers >=0.6
      , vector >=0.12
      , hspec >=2.10
      , QuickCheck >=2.14
      , cryptonite >=0.30
      , postgresql-simple >=0.6
      , resource-pool >=0.3
      , network >=3.1
      , network-bsd
      , os-string >=2.0
      , filepath >=1.4 && <1.6
      , fast-logger >=3.0
      , monad-logger >=0.3
      , wai-extra >=3.1
      , wai-websockets >=3.0
      , websockets >=0.12
      , scientific >=0.3
      , stm >=2.5
      , transformers >=0.5

    default-language: Haskell2010
    ghc-options: -Wall
-- ============================================================================
-- EXECUTABLE
-- ============================================================================
executable surypus
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.12 && <5
    , Surypus
    , text >=1.2
    , aeson >=2.0
    , warp >=3.3
    , http-types >=0.12
    , wai >=3.2
    , bytestring >=0.10
    , containers >=0.6
    , transformers >=0.5
    , time >=1.8
    , hasql-pool >=0.7
  default-language: Haskell2010
  ghc-options: -threaded
executable surypus-job-worker
  main-is: JobWorker.hs
  hs-source-dirs: app
  build-depends:
      base >=4.12 && <5
    , Surypus
    , hasql >=1.4.5.3
    , hasql-pool >=0.7
    , bytestring >=0.10
    , text >=1.2
    , time >=1.8
    , containers >=0.6
    , transformers >=0.5
    , vector >=0.12
  default-language: Haskell2010
test-suite test
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test, src
  other-modules:
      Core.Accounting.Account
      Core.Tax
      Core.Payroll.Calculation
      Core.Payroll.Types
      Core.Refined
      Surypus.Types
      Surypus.Reports.Conversion.CrystalTypes
  build-depends:
      base >=4.12 && <5
    , Surypus
    , text >=1.2
    , time >=1.8
    , hspec >=2.10
    , QuickCheck >=2.14
    , uuid >=1.3
    , bytestring >=0.10
    , aeson >=2.0
    , containers >=0.6
    , vector >=0.12
  default-language: Haskell2010

-- Integration test: pool wiring sanity check
test-suite test-integration-pool
  type: exitcode-stdio-1.0
  main-is: PoolSpec.hs
  hs-source-dirs: test/Integration
  build-depends:
      base >=4.12 && <5
    , Surypus
    , hasql >=1.6.0.0
    , hasql-pool >=0.7
    , text >=1.2
    , time >=1.8
    , hspec >=2.10
  default-language: Haskell2010

-- Integration test: API CRUD over real DB
test-suite test-integration-api
  type: exitcode-stdio-1.0
  main-is: APICrudSpec.hs
  hs-source-dirs: test/Integration
  build-depends:
      base >=4.12 && <5
    , Surypus
    , aeson >=2.0
    , bytestring >=0.10
    , hasql >=1.6.0.0
    , hasql-pool >=0.7
    , text >=1.2
    , time >=1.8
    , hspec >=2.10
    , http-conduit >=2.3
    , http-types >=0.12
  default-language: Haskell2010
  ghc-options: -threaded
