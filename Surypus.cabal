cabal-version: 3.4
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        GPL-3.0-or-later
build-type:     Simple

library
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
    API.Integration.REST
    Core.Services.Accounting
    DAL.Classifiers
    DAL.ClassifiersORM
    DAL.Conversion
    DAL.Database
    DAL.EventStore
    DAL.Hasql.Database
    DAL.Migration
    DAL.Mutations
    DAL.MutationsORM
    DAL.ORMPool
    DAL.Procedures
    DAL.Queries
    DAL.QueriesORM
    DAL.Repository
    DAL.Schema
    DAL.Types
     Finance.Accounting
     Finance.Tax
    Infrastructure.Email
    Infrastructure.EventStore.Accounting
    Infrastructure.EventStore.Inventory
    Infrastructure.Redis.TaskQueue
    Infrastructure.WebSocket.InventoryBroadcast
    Integration.Adapter
    Integration.Health
     Inventory.Stock
     Production.Types
     Science.ML.DemandForecasting
    Science.ML.Features
    Security.Quantum.Crypto
    Service.InventoryLifecycleService
    Service.InventoryService
    Surypus
    Surypus.AI.Anthropic
    Surypus.AI.OpenAI
    Surypus.Api
    Surypus.API.AI
    Surypus.API.Bills
    Surypus.API.Bridge
    Surypus.API.Bridge.AuthBridge
    Surypus.API.Classifiers
    Surypus.API.CRM
    Surypus.API.Dashboard
    Surypus.API.Documents.InventoryDocs
    Surypus.API.Goods
    Surypus.API.Integrations
    Surypus.API.Logger
    Surypus.API.Notifications
    Surypus.API.Orders
    Surypus.API.Payment
    Surypus.API.Persons
    Surypus.API.Production
    Surypus.API.Reports
    Surypus.API.Server
    Surypus.API.Workflow
    Surypus.Codecs
    Surypus.Core
    Surypus.CoreTypes
    Surypus.EventBridge
    Surypus.Foreign.QML
    Surypus.JWT
    Surypus.JWT.Token
    Surypus.Metrics
    Surypus.PDF
    Surypus.RBAC
    Surypus.Refined
    Surypus.Reports.Conversion.CrystalToPdfSlave
    Surypus.Reports.Conversion.CrystalTypes
    Surypus.Reports.Templates
    Surypus.Types
    Surypus.Types.Auth
    Surypus.Types.Bill
    Surypus.Types.Common
    Surypus.Types.Goods
    Surypus.Types.Legacy
    Surypus.Types.Payment
    Surypus.Types.Person
    Surypus.Types.Stock
    Surypus.WebSocket
    System.CircuitBreaker
  build-depends:
    base >=4.12 && <5
    , text >=1.2
    , time >=1.8
    , uuid >=1.3
    , aeson >=2.2
    , containers >=0.6
    , vector >=0.12
    , transformers >=0.5
    , mtl >=2.3
    , QuickCheck >=2.14
    , Decimal >=0.5
    , stm >=2.5
    , directory >=1.3
    , filepath >=1.4
    , wai >=3.2
    , warp >=3.3
    , servant >=0.20
    , servant-server >=0.20
    , http-types >=0.12
    , fast-logger >=3.2
    , random >=1.2
    , bytestring >=0.11
    , http-client >=0.7
    , lens >=5.2
    , hspec >=2.11
    , resource-pool >=0.2 && <0.3
    , persistent >=2.14
    , persistent-postgresql >=2.14
    , persistent-template >=2.14
    , esqueleto >=3.5
    , monad-logger >=0.3
    , scotty >=0.12
    , wai-extra >=3.1
    , jose >=0.10 && <0.11
    , websockets >=0.12
    , wai-websockets >=0.2
    , cryptonite >=0.30
    , ekg >=0.4.0
    , messagepack >=0.5
    , cborg >=0.2
    , hedis >=0.14
    , http-conduit >=2.3
    , mime-mail >=0.5
    , smtp-mail >=0.3
    , network-uri >=2.6
    , unordered-containers >=0.2
    , deriving-aeson >=0.2


executable surypus-server
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , wai
    , wai-extra
    , warp
    , aeson
    , text
    , bytestring
    , http-types
    , time
    , directory
    , filepath
    , Decimal
  default-extensions: OverloadedStrings

test-suite surypus-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  other-modules:
      Finance.TaxSpec
      Finance.AccountingSpec
  build-depends:
      base >=4.12 && <5
      , Surypus
      , hspec
      , QuickCheck
      , text
      , time
      , aeson
      , bytestring
      , stm
      , containers
      , Decimal
  default-language: Haskell2010
