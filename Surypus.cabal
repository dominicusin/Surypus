  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  build-depends:
      base >=4.12 && <5
    , Surypus
    , hspec
    , QuickCheck
    , text
    , time
    , aeson
    , bytestring
    , hasql
    , hasql-pool
    , stm
    , containers
  default-language: Haskell2010
    
